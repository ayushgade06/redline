# Copy to backend/.env and fill in. Never commit backend/.env.

# Option A (default): call Anthropic directly
ANTHROPIC_API_KEY=

# Option B: route every LLM call through the Prune gateway (signed receipts, cache, Shield, spend caps).
# When PRUNE_API_KEY is set, it is used instead of calling Anthropic directly.
PRUNE_API_KEY=
PRUNE_BASE_URL=https://api.withprune.com/v1
# If your Prune vault names models differently, map them, e.g.:
# PRUNE_MODEL_CLAUDE_SONNET_5_5=anthropic/claude-sonnet-5-5

# Models (chosen by the bake-off, eval/results/bakeoff_*.csv)
MODEL_PRIMARY=claude-sonnet-5-5
MODEL_FALLBACK=claude-haiku-5-5
MODEL_HINT=claude-haiku-5-5

# Lines read with confidence below this are highlighted for the student to confirm
CONFIDENCE_TAU=0.8
LLM_TIMEOUT=60
RATE_LIMIT_PER_10MIN=30
